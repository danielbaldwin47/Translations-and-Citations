*.db filter=lfs diff=lfs merge=lfs -text

# The Store zip (tools/build-store-zip.js, `git archive`) leaves these out:
# only the extension itself ships.
/docs export-ignore
/tools export-ignore
*.md export-ignore
.gitattributes export-ignore
.gitignore export-ignore
# The Store zip's stamp replaces the repo's (tools/build-store-zip.js).
/src/citations/store-stamp.json export-ignore
