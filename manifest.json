{
  "manifest_version": 3,
  "name": "Translations & Citations for Gospel Library",
  "version": "0.1.0",
  "description": "Read each scripture chapter beside another Bible translation or Church language, and see the talks that cite every verse.",
  "permissions": ["storage"],
  "host_permissions": [
    "https://api.scripture.api.bible/*",
    "https://bible-api.com/*"
  ],
  "background": {
    "service_worker": "src/background/service-worker.js"
  },
  "content_scripts": [
    {
      "matches": ["https://www.churchofjesuschrist.org/study*"],
      "js": [
        "src/shared/constants.js",
        "src/shared/settings.js",
        "src/shared/books.js",
        "src/content/sanitize.js",
        "src/content/church-text.js",
        "src/content/page-split.js",
        "src/content/theme.js",
        "src/content/detect.js",
        "src/content/panel.js",
        "src/citations/cit-data.js",
        "src/citations/cit-view-model.js",
        "src/citations/highlights.js",
        "src/citations/talk-source.js",
        "src/citations/talk-view.js",
        "src/citations/cit-panel.js",
        "src/content/content.js"
      ],
      "css": ["src/content/panel.css", "src/citations/citations.css", "src/content/page-split.css"],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["src/citations/data/*", "src/content/page-hook.js"],
      "matches": ["https://www.churchofjesuschrist.org/*"]
    }
  ],
  "options_ui": {
    "page": "src/options/options.html",
    "open_in_tab": true
  },
  "action": {
    "default_title": "Show or hide Translations & Citations"
  },
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  }
}
